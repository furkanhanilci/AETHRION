# AI Research Framework — Bridge V0 örnek yapılandırması
# Kopyalayın: cp .env.example .env  ve kendi yollarınızla doldurun.
# .env asla commit edilmez (.gitignore).

# API yalnız loopback üzerinde dinleyebilir; başka değer servisi başlatmaz.
AIRL_API_HOST=127.0.0.1
AIRL_API_PORT=8765

# Repo köküne göreli veya mutlak yol
AIRL_DATABASE_PATH=./data/airl_bridge.sqlite3

# Zotero Local API — Ayarlar > Gelişmiş > "diğer uygulamalar iletişim kurabilsin"
AIRL_ZOTERO_BASE_URL=http://127.0.0.1:23119/api
AIRL_ZOTERO_LIBRARY_TYPE=users
AIRL_ZOTERO_LIBRARY_ID=0

# Obsidian vault mutlak yolu
AIRL_OBSIDIAN_VAULT=<VAULT_ABSOLUTE_PATH>

# Vault içinde otomatik yönetilen dal (göreli; .. içeremez)
AIRL_OBSIDIAN_GENERATED_DIR=70 - Literature Sets/Zotero Sources
