# AETHRION — Bridge V0 example configuration
# Copy it with:  cp .env.example .env   and fill in your own paths.
# .env is never committed (see .gitignore).

# The API may listen on loopback only; any other value refuses to start.
AIRL_API_HOST=127.0.0.1
AIRL_API_PORT=8765

# Relative to the repository root, or an absolute path
AIRL_DATABASE_PATH=./data/airl_bridge.sqlite3

# Zotero Local API — Settings > Advanced > "Allow other applications on this
# computer to communicate with Zotero"
AIRL_ZOTERO_BASE_URL=http://127.0.0.1:23119/api
AIRL_ZOTERO_LIBRARY_TYPE=users
AIRL_ZOTERO_LIBRARY_ID=0

# Absolute path to the Obsidian vault
AIRL_OBSIDIAN_VAULT=<VAULT_ABSOLUTE_PATH>

# The automatically managed branch inside the vault (relative; may not contain ..)
AIRL_OBSIDIAN_GENERATED_DIR=70 - Literature Sets/Zotero Sources

# --- The two controls on the HTTP surface (finding M1) ---------------------
#
# AIRL_API_TOKEN gates the three mutating endpoints via an X-AIRL-Token header.
# A custom header is not on the CORS safelist, so a cross-site page cannot send
# one without a preflight it cannot satisfy — that is the whole CSRF defence.
#
# Leaving it EMPTY does not open the endpoints; they return 503. Failing open on
# missing configuration is how a mandatory control becomes optional in practice
# while staying mandatory on paper.
#
#     AIRL_API_TOKEN=$(python3 -c "import secrets; print(secrets.token_urlsafe(32))")
#
AIRL_API_TOKEN=<GENERATE_A_TOKEN>

# AIRL_ALLOWED_HOSTS is checked against the request's Host header, on every
# request including the reads. This is the DNS-rebinding defence and it is a
# separate control: rebinding turns an attacker's page into 127.0.0.1 after it
# has loaded, and the browser then treats GET /v1/sources as same-origin. A
# token on the writes does nothing about that.
AIRL_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
