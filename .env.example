# AI Research Framework — Bridge V0 example configuration
# Copy it with:  cp .env.example .env   and fill in your own paths.
# .env is never committed (see .gitignore).

# The API may listen on loopback only; any other value refuses to start.
AIRL_API_HOST=127.0.0.1
AIRL_API_PORT=8765

# Relative to the repository root, or an absolute path
AIRL_DATABASE_PATH=./data/airl_bridge.sqlite3

# Zotero Local API — Settings > Advanced > "Allow other applications on this
# computer to communicate with Zotero"
AIRL_ZOTERO_BASE_URL=http://127.0.0.1:23119/api
AIRL_ZOTERO_LIBRARY_TYPE=users
AIRL_ZOTERO_LIBRARY_ID=0

# Absolute path to the Obsidian vault
AIRL_OBSIDIAN_VAULT=<VAULT_ABSOLUTE_PATH>

# The automatically managed branch inside the vault (relative; may not contain ..)
AIRL_OBSIDIAN_GENERATED_DIR=70 - Literature Sets/Zotero Sources
