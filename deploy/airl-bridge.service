[Unit]
Description=AIRL Zotero to Obsidian Bridge API
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/otonom/Desktop/FH/AI_RESEARCH_FRAMEWORK/airl_bridge_api
ExecStart=/home/otonom/Desktop/FH/AI_RESEARCH_FRAMEWORK/airl_bridge_api/.venv/bin/airl-bridge serve
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/otonom/Desktop/FH/AI_RESEARCH_FRAMEWORK/airl_bridge_api/data
ReadWritePaths="/home/otonom/Documents/Obsidian Vault/70 - Literature Sets/Zotero Sources"
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
